# Copy this file to `.env` in the location described below. The app reads ONLY
# the named variables below; it never imports the whole file. Values never
# reach logs, the database, or the UI. This file is maintained by the user —
# the app never writes or deletes it.
#
# Location (macOS 0.2.0):
#   - Bundled app: the stable data directory
#     ~/Library/Application Support/AiCouncil/.env
#     (or $AICOUNCIL_DATA_DIR/.env for isolated runs)
#   - Development (cargo run from the project root): the project-root .env
#     is picked up as a fallback.
#
# OpenRouter key used for chat completions (required):
OPENROUTER_API_KEY=
#
# DeepSeek key for automatic chat titles (optional; titles fall back without it):
DEEPSEEK_API_KEY=
#
# After placing or changing this file, use the in-app reload (or restart):
# both provider clients are rebuilt from the named variables.
